<?xml version="1.0" encoding="UTF-8"?>
<!-- TwiML Bin for the Al Kindi demo — language menu version.
     NOTE: the live number's Voice webhook points at
     https://al-kindi-sara-demo.onrender.com/twiml, which serves this
     same menu from server.py. This file is only a backup if the
     webhook is ever switched back to a TwiML Bin.
     1. In the Twilio Console, go to Develop > TwiML > TwiML Bins > Create new TwiML Bin.
     2. Paste this whole file, replacing YOUR-PUBLIC-DOMAIN with your
        public domain (Render: al-kindi-sara-demo.onrender.com).
     3. Save, then link your Twilio number to this bin.
     Flow: press 1 for English, 2 for Arabic; no press defaults to English.
     On a trial account the caller first hears Twilio's trial message and
     must press any key before this TwiML is fetched. -->
<Response>
  <Gather numDigits="1" timeout="5" action="https://YOUR-PUBLIC-DOMAIN/choose-language" method="POST">
    <Say language="en-US">For English, press 1. For Arabic, press 2.</Say>
    <Say language="ar-SA">للغة العربية، اضغط 2. For English, press 1.</Say>
  </Gather>
  <Redirect method="POST">https://YOUR-PUBLIC-DOMAIN/choose-language</Redirect>
</Response>
