# Copy this file to .env and fill in your own keys. NEVER commit a real .env.
# No real credentials are stored in this repo — placeholders only.

# Twilio — from your Twilio Console dashboard (https://console.twilio.com)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token-here
# The Twilio number you buy, in E.164 format, e.g. +1 415 555 0132
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# DeepSeek — from https://platform.deepseek.com/api_keys
# Top up a small amount (a few dollars is plenty for a demo).
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
# DeepSeek V4.1 Flash via LiteLLM. Leave this line as-is.
DEEPSEEK_MODEL=deepseek/deepseek-flash

# Public WebSocket URL Twilio connects to (your ngrok domain, no scheme
# in the TwiML Bin — but WITH the wss:// scheme here, e.g.
# wss://03ca546a6a10.ngrok.io/ws). Leave blank until you run ngrok.
PUBLIC_WS_URL=

# Local port the server listens on.
PORT=8000
